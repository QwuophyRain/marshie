# Copy to .env (Raspberry Pi, Mac, Windows) or add these in Vercel -> Project Settings -> Environment Variables.

# ---- Teacher panel -------------------------------------------------------
# PIN to open the Teacher panel (upload Excel, templates, teaching, settings).
# CHANGE THIS before the event.
ADMIN_PIN=2468
# Long random string used to sign teacher sessions. Generate with:  python3 -c "import secrets;print(secrets.token_hex(24))"
# Leave this blank and Marshie makes one for you (python marshie.py setup does it).
SECRET_KEY=

# ---- Personality ---------------------------------------------------------
BOT_NAME=Marshie
SCHOOL_NAME=Ecole Ronsard
EVENT_NAME=STEAM Program 2026
SCHOOL_URL=https://ecole-ronsard.com/
# What she says when she wakes up. {name} and {school} are filled in. Blank = the standard Ecole Ronsard greeting.
# (Easier: change it in the Teacher panel, Look and words.)
GREETING=

# ---- School colours (blank = the Ecole Ronsard logo colours) -------------
# Easier: change them in the Teacher panel, Look and words.
# THEME_PRIMARY=#045870
# THEME_BUTTON=#fae240
# THEME_HIGHLIGHT=#e80075
# THEME_SUCCESS=#74bd54

# ---- Words the browser voice says wrongly ---------------------------------
# "Written=How to say it;Other=Say it". Ecole and Ronsard are already in the list.
SPEECH_FIXES=

# ---- Pictures, recordings and videos -------------------------------------
# Largest file a teacher can add, in MB. Blank = 40 on a computer, 3 on Vercel.
MAX_MEDIA_MB=

# ---- Optional paid AI "brain" (leave blank to run 100% offline) -----------
# The easy way is the Teacher panel, "Paid AI" tab: paste the key there, press Test it. What is saved there wins over these.
# When set, Marshie first searches her own knowledge. If she is not confident,
# she asks the LLM (given the best local facts as context) and answers kindly.
#   anthropic  -> Claude API
#   openai     -> any OpenAI-compatible API (OpenAI, Ollama, LM Studio, llama.cpp server...)
LLM_PROVIDER=
LLM_API_KEY=
# Optional overrides. Defaults: anthropic -> claude-haiku-5-5 ; openai -> gpt-4o-mini
LLM_MODEL=
# Only for provider=openai. Ollama example: http://localhost:11434/v1
LLM_BASE_URL=

# ---- Offline voice (any computer, after:  python marshie.py voice) -------
# These are the defaults, so you only need to change them to use different voice files.
# PIPER_MODEL=voices/en_US-amy-low.onnx
# VOSK_MODEL=voices/vosk-model-small-en-us-0.15

# ---- Where taught/uploaded knowledge is saved ----------------------------
# Raspberry Pi, Mac, Windows: leave blank, a file is kept in ./data/state.json
# Vercel: add an Upstash Redis / Vercel KV store so teaching survives restarts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
